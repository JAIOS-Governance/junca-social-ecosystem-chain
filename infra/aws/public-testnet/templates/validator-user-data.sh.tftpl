#!/usr/bin/env bash
set -euo pipefail
umask 027

install -d -m 0750 /etc/junca /var/lib/junca /var/log/junca
getent group junca >/dev/null || groupadd --system junca
id -u junca >/dev/null 2>&1 || \
  useradd --system --gid junca --home-dir /var/lib/junca --shell /sbin/nologin junca

%{ if validator_state_required ~}
validator_state_volume_id='${validator_state_volume_id}'
[[ "$validator_state_volume_id" =~ ^vol-[0-9a-f]{8,17}$ ]]
validator_state_serial="$${validator_state_volume_id//-/}"

cat >/usr/local/sbin/junca-mount-validator-state <<EOF
#!/usr/bin/env bash
set -euo pipefail
volume_id='$${validator_state_volume_id}'
expected_serial='$${validator_state_serial}'
device="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${expected_serial}"
for attempt in \$(seq 1 120); do
  if [[ -b "\$device" ]]; then
    break
  fi
  mapfile -t candidates < <(
    lsblk -dnpo NAME,SERIAL,TYPE |
      awk -v expected="\$expected_serial" \
        '{ serial=\$2; gsub(/-/, "", serial); if (\$3 == "disk" && serial == expected) print \$1 }'
  )
  if [[ "$${#candidates[@]}" == 1 && -b "$${candidates[0]}" ]]; then
    device="$${candidates[0]}"
    break
  fi
  test "\$attempt" -lt 120
  sleep 5
done
[[ -b "\$device" ]]
resolved_device="\$(readlink -f "\$device")"
[[ -b "\$resolved_device" ]]
actual_serial="\$(lsblk -ndo SERIAL "\$device" | tr -d '-')"
test "\$actual_serial" = "\$expected_serial"
filesystem="\$(blkid -o value -s TYPE "\$device")"
case "\$filesystem" in
  ext4|xfs) ;;
  *) echo "validator state filesystem is absent or unapproved" >&2; exit 1 ;;
esac
if ! mountpoint -q /var/lib/junca; then
  mount -o noatime,nosuid,nodev "\$device" /var/lib/junca
fi
test "\$(findmnt -n -o SOURCE --target /var/lib/junca)" = "\$resolved_device"
test -f /var/lib/junca/state.sqlite
test ! -L /var/lib/junca/state.sqlite
EOF
chmod 0750 /usr/local/sbin/junca-mount-validator-state

cat >/etc/systemd/system/junca-validator-state.service <<'EOF'
[Unit]
Description=JUNCA Validator Durable State Mount
Before=junca-validator.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/junca-mount-validator-state
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
%{ endif ~}

cat >/etc/junca/runtime.env <<'EOF'
CHAIN_NAME=JUNCA Social Ecosystem Chain
GOVERNANCE=JAIOS Institutional Governance
NETWORK_NOTICE=Public Testnet / No Monetary Value
VALIDATOR_ID=${validator_id}
CHAIN_ID=${chain_id}
GENESIS_SHA256=${genesis_sha256}
NODE_ARTIFACT_SHA256=${node_sha256}
SIGNER_RESOURCE_ARN=${signer_arn}
AWS_REGION=${aws_region}
AWS_DEFAULT_REGION=${aws_region}
PUBLIC_RPC=false
P2P_PORT=30303
# Comma-separated exact-three contracts:
# validator-01=arn:aws:kms:...,... and validator-01=10.x.x.x:30303,...
VALIDATOR_SIGNER_BINDINGS=${signer_bindings}
VALIDATOR_PEER_ENDPOINTS=${peer_endpoints}
AUTOMATIC_FINALITY_ENABLED=${automatic_finality_enabled}
TESTNET_BLOCK_INTERVAL_SECONDS=${block_interval_seconds}
TESTNET_SLOT_EPOCH_SECONDS=${slot_epoch_seconds}
BRIDGE_ACTIVATED=false
EOF
chmod 0640 /etc/junca/runtime.env
chown root:junca /etc/junca/runtime.env

# The approved AMI must provide /usr/local/bin/junca-chain-node and /etc/junca/genesis.json.
# No private key, mnemonic or signer secret is written by this bootstrap.
test -x /usr/local/bin/junca-chain-node
printf '%s  %s\n' '${genesis_sha256}' /etc/junca/genesis.json | sha256sum --check --strict
printf '%s  %s\n' '${node_sha256}' /opt/junca/validator-runtime.tar.gz | sha256sum --check --strict

cat >/etc/systemd/system/junca-validator.service <<'EOF'
[Unit]
Description=JUNCA Social Ecosystem Chain Validator
After=network-online.target%{ if validator_state_required } junca-validator-state.service%{ endif }
Wants=network-online.target
%{ if validator_state_required ~}
Requires=junca-validator-state.service
RequiresMountsFor=/var/lib/junca
ConditionPathIsMountPoint=/var/lib/junca
ConditionPathExists=/var/lib/junca/state.sqlite
%{ endif ~}

[Service]
Type=simple
User=junca
Group=junca
EnvironmentFile=/etc/junca/runtime.env
%{ if validator_state_required ~}
ExecStartPre=/usr/bin/test -f /var/lib/junca/state.sqlite
ExecStartPre=/usr/bin/test ! -L /var/lib/junca/state.sqlite
%{ endif ~}
ExecStart=/usr/local/bin/junca-chain-node --config /etc/junca/validator.toml --genesis /etc/junca/genesis.json --data-dir /var/lib/junca --validator-id "$VALIDATOR_ID" --http.addr 127.0.0.1 --http.port 8545 --http.api eth,net,web3 --mine --signer-resource "$SIGNER_RESOURCE_ARN"
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/junca /var/log/junca
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
EOF

cat >/etc/systemd/system/junca-public-rpc.service <<'EOF'
[Unit]
Description=JUNCA Public Testnet Read-only RPC Gateway
After=junca-validator.service
Requires=junca-validator.service

[Service]
Type=simple
User=junca
Group=junca
ExecStart=/usr/local/bin/junca-public-gateway --upstream http://127.0.0.1:8545/ --http.addr 0.0.0.0 --http.port 8546
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
EOF

cat >/etc/systemd/system/junca-public-explorer.service <<'EOF'
[Unit]
Description=JUNCA Public Testnet Finalized-only Explorer
After=junca-validator.service
Requires=junca-validator.service

[Service]
Type=simple
User=junca
Group=junca
ExecStart=/usr/local/bin/junca-public-gateway --upstream http://127.0.0.1:8545/ --http.addr 0.0.0.0 --http.port 3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
%{ if validator_state_required ~}
systemctl enable junca-validator-state.service
%{ endif ~}
systemctl enable --now junca-validator.service
systemctl enable --now junca-public-rpc.service junca-public-explorer.service

for port in 8545 8546 3000; do
  for attempt in $(seq 1 60); do
    if ss -lntH "sport = :$port" | grep -q .; then
      break
    fi
    test "$attempt" -lt 60
    sleep 2
  done
done
curl -fsS http://127.0.0.1:8545/health >/dev/null
curl -fsS http://127.0.0.1:3000/health >/dev/null

logger -t junca-bootstrap "validator=${validator_id} governance=JAIOS_Institutional_Governance log_group=${cloudwatch_log_name} state=started"
