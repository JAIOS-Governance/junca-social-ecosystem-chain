    {"id": "trust_stack", "status": "IMPLEMENTED", "requirements": ["Map requirement to control, evidence, and reporting for every trust layer."]},
    {"id": "protocol_kernel", "status": "IMPLEMENTED", "requirements": ["Define deterministic identity, compatibility, migration, finality, and rollback boundaries."]},
    {"id": "execution", "status": "IMPLEMENTED", "requirements": ["Treat EVM compatibility as a conformance profile and future runtimes as versioned plug-ins."]},
    {"id": "developer_experience", "status": "IMPLEMENTED", "requirements": ["Version RPC, SDK, build, verification, local development, and migration contracts."]},
    {"id": "enterprise_adoption", "status": "IMPLEMENTED", "requirements": ["Separate permissions, custody, tenants, projects, regulated assets, and credentials."]},
    {"id": "scalability", "status": "IMPLEMENTED", "requirements": ["Separate targets from verified measurements and reject inferred performance claims."]},
    {"id": "security", "status": "IMPLEMENTED", "requirements": ["Gate supply chain, upgrades, keys, incidents, recovery, reviews, and bounty readiness."]},
    {"id": "interoperability", "status": "IMPLEMENTED", "requirements": ["Use a paused route registry with finality, replay, limits, custody, and review gates."]},
    {"id": "ai_native_operations", "status": "IMPLEMENTED", "requirements": ["Route Read, Write, Execute, Evidence, Approval, and Maintenance under institutional governance."]},
    {"id": "global_operations", "status": "IMPLEMENTED", "requirements": ["Define region, failure-domain, SLO, observability, backup, DR, residency, and compliance contracts."]},
    {"id": "ecosystem_selection", "status": "IMPLEMENTED", "requirements": ["Compare ecosystems only through common dimensions and official primary evidence."]},
    {"id": "roadmap", "status": "IMPLEMENTED", "requirements": ["Gate Public Testnet through Mainnet using machine-readable exit criteria."]}
  ],
  "one_core_contract": [
