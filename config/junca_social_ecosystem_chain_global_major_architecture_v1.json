    {"id": "auditability", "requirement": "Material actions are independently reconstructable.", "control": "Tamper-evident evidence chains.", "evidence": "Digest-linked audit records.", "reporting": "Audit evidence package."},
    {"id": "reporting", "requirement": "Measured state is separated from target state.", "control": "Versioned report schemas and source requirements.", "evidence": "Primary-source references and digests.", "reporting": "Machine-readable and human-readable release report."}
